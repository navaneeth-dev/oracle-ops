{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':disableRateLimiting',
    ':semanticCommits',
  ],
  timezone: 'Asia/Kolkata',
  'helm-values': {
    managerFilePatterns: [
      '/k8s/.+\\.yaml$/',
    ],
  },
  kubernetes: {
    managerFilePatterns: [
      '/\\.yaml$/',
    ],
  },
  helmv3: {
    managerFilePatterns: [
      '/\\.yaml$/',
    ],
  },
  flux: {
    managerFilePatterns: [
      '/k8s/.+\\.yaml$/',
    ],
  },
  suppressNotifications: [
    'prEditedNotification',
    'prIgnoreNotification',
  ],
  packageRules: [
    {
      description: 'Auto-merge terraform',
      matchDatasources: [
        'terraform-module',
        'terraform-provider',
      ],
      automerge: true,
      automergeType: 'branch',
      ignoreTests: true,
    },
    {
      description: 'Auto-merge non-major sonarr and radarr updates',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/home-operations/sonarr',
        'ghcr.io/home-operations/radarr',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      automerge: true,
      automergeType: 'branch',
      ignoreTests: true,
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/bootstrap/talos/talenv.yaml/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[\\w-]+?) depName=(?<depName>[^\\s]+?)\\s+\\w+: (?<currentValue>.*)\\s',
      ],
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/k8s/infrastructure/configs/victoria-metrics/grafanadatasource-victoria-logs.yaml/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) packageName=(?<packageName>[^\\s]+?)\\s+\\w+: (?<currentValue>.*)\\s"
      ],
    },
  ],
}
