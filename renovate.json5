{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':disableRateLimiting',
    ':semanticCommits',
  ],
  timezone: 'Asia/Kolkata',
  'helm-values': {
    managerFilePatterns: [
      '/k8s/.+\\.yaml$/',
    ],
  },
  kubernetes: {
    managerFilePatterns: [
      '/\\.yaml$/',
    ],
  },
  helmv3: {
    managerFilePatterns: [
      '/\\.yaml$/',
    ],
  },
  flux: {
    managerFilePatterns: [
      '/k8s/.+\\.yaml$/',
    ],
  },
  suppressNotifications: [
    'prEditedNotification',
    'prIgnoreNotification',
  ],
  packageRules: [
    {
      description: 'Flux Operator Group',
      groupName: 'flux-operator',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/controlplaneio-fluxcd/charts/flux-operator',
        'ghcr.io/controlplaneio-fluxcd/charts/flux-instance',
      ],
      group: {
        commitMessageTopic: '{{{groupName}}} group',
      },
      minimumGroupSize: 2,
    },
    {
      description: 'Auto-merge terraform',
      matchDatasources: [
        'terraform-module',
        'terraform-provider',
      ],
      automerge: true,
      automergeType: 'branch',
      ignoreTests: true,
    },
    {
      description: 'Auto-merge home-operations digest updates through checked PRs',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/home-operations/**',
      ],
      matchUpdateTypes: [
        'digest',
      ],
      automerge: true,
      automergeType: 'pr',
      platformAutomerge: false,
      ignoreTests: false,
    },
    {
      description: 'Auto-merge stable docker packages after seven days',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/home-operations/sonarr',
        'ghcr.io/home-operations/radarr',
        'ghcr.io/home-operations/prowlarr',
        'ghcr.io/home-operations/qbittorrent',
        'ghcr.io/advplyr/audiobookshelf',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      minimumReleaseAge: '7 days',
      automerge: true,
      automergeType: 'pr',
      platformAutomerge: false,
      ignoreTests: false,
    },
    {
      description: 'Auto-merge non-major create-github-app-token updates',
      matchDepNames: [
        'actions/create-github-app-token',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      automerge: true,
      automergeType: 'branch',
      ignoreTests: true,
    },
    {
      description: 'Auto-merge non-major renovatebot github-action updates',
      matchDepNames: [
        'renovatebot/github-action',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      automerge: true,
      automergeType: 'branch',
      ignoreTests: true,
    },
    {
      description: 'Auto-merge non-major Mise updates',
      matchManagers: [
        'mise',
      ],
      matchDepNames: [
        'terraform',
        'yq',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      automerge: true,
      automergeType: 'branch',
      ignoreTests: true,
    },
    {
      description: 'Auto-merge non-major blackbox-exporter chart updates',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/prometheus-community/charts/prometheus-blackbox-exporter',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      automerge: true,
      automergeType: 'branch',
      ignoreTests: true,
    },
    {
      description: 'Auto-merge librespeed digest updates',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/librespeed/speedtest',
      ],
      matchUpdateTypes: [
        'digest',
      ],
      automerge: true,
      automergeType: 'branch',
      ignoreTests: true,
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      description: 'Process annotated container image dependencies (repo:tag@digest)',
      managerFilePatterns: [
        '/\\.yaml$/',
      ],
      matchStrings: [
        '# renovate-image: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[\\w.-]+:\\s*[^:\\s]+:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)',
      ],
    },
    {
      customType: 'regex',
      description: 'Process annotated plain version dependencies (key: version)',
      managerFilePatterns: [
        '/\\.yaml$/',
      ],
      matchStrings: [
        '# renovate-semver: datasource=(?<datasource>\\S+) (?:depName|packageName)=(?<packageName>\\S+)\\s+[\\w.-]+:\\s*"?(?<currentValue>[^"\\s]+)"?',
      ],
      depNameTemplate: '{{{packageName}}}',
      extractVersionTemplate: '^v?(?<version>.+)$',
    },
  ],
}
